#!/usr/bin/make -f

DEST := $(CURDIR)/debian/apx-stacks/usr/share/apx

%:
	dh $@

# apx only scans a flat directory, but apx-community groups stacks
# into per-distro subdirectories, so flatten them.
override_dh_auto_install:
	install -d $(DEST)/stacks $(DEST)/package-managers
	install -m644 stacks/*/*.yml $(DEST)/stacks/
	# Base distro stacks from vanilla-apx-configs, which is where Vanilla OS
	# maintains the ones it ships; apx-community has not moved since 2025.
	install -m644 debian/stacks-vanilla/*.yaml $(DEST)/stacks/
	# Our own stacks: neither upstream has one for Debian testing or sid.
	install -m644 debian/stacks-debian/*.yml $(DEST)/stacks/
	# Package managers from one source only. apx lists every file in the
	# directory, so apt.yml beside apt.yaml would show "apt" twice.
	install -m644 debian/pkgmanagers-vanilla/*.yaml $(DEST)/package-managers/
